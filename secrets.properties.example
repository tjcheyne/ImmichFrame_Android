# Copy this file to "secrets.properties" and fill in your values.
# secrets.properties is gitignored and injected into the build as default
# values for the server URL and authorization secret.
#
# In CI (GitHub Actions) these are supplied via repository secrets of the
# same name (DEFAULT_WEBVIEW_URL / DEFAULT_AUTH_SECRET) instead of this file.
DEFAULT_WEBVIEW_URL=
DEFAULT_AUTH_SECRET=
